# Server Configuration
# Back4app will automatically assign a PORT, but you can set a default here
PORT=5005
NODE_ENV=production

# Database Configuration
# Get your MongoDB connection string from MongoDB Atlas or similar
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>

# Security
# Set a long random string for JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# External Services APIs (Required for core functionality)
# Google Gemini API Key (Required for AI evaluation and question generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Murf AI API Key (Required for natural interviewer voice synthesis)
MURF_API_KEY=your_murf_api_key_here

# AssemblyAI API Key (Required for candidate speech-to-text audio transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# CORS Configuration
# Set this to your frontend URL after deploying the client (e.g., your Vercel/Firebase client URL)
CLIENT_URL=https://your-client-app.vercel.app

# Resend Transactional Email Configuration (Required for interview notifications & scorecards)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=MockAI Interviews <onboarding@resend.dev>
APP_URL=https://your-client-app.vercel.app
